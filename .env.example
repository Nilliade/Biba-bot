# Токен Discord-бота (обязательно)
DISCORD_TOKEN=put-your-token-here

# Путь к SQLite-базе. По умолчанию — существующая база Minerea.
DATABASE_PATH=data/minerea.sqlite

# ID сервера для мгновенной синхронизации slash-команд во время разработки.
# Если пусто — команды синхронизируются глобально (может занять до часа).
DEV_GUILD_ID=

# false = игра идёт без подключения к голосу (удобно для разработки/тестов)
VOICE_ENABLED=true

# Путь к ffmpeg. Обычно просто ffmpeg, если он установлен в PATH.
FFMPEG_PATH=ffmpeg

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

COMMAND_PREFIX=!
